# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chiave segreta: solo lato server, usata dal server MCP. Mai nel browser né in chat.
SUPABASE_SECRET_KEY=sb_secret_...
# Stringa casuale di almeno 32 caratteri (es. `openssl rand -base64 48`).
# Firma i token del connettore Claude: cambiarla scollega Claude.
OAUTH_SECRET=

# Bot Telegram (facoltativo): salva in bozza i post Instagram che gli mandi.
# Token dato da @BotFather.
TELEGRAM_BOT_TOKEN=
# Stringa casuale (solo lettere, cifre, _ e -; es. `openssl rand -hex 32`): Telegram la rimanda al webhook.
TELEGRAM_WEBHOOK_SECRET=
# Il tuo id numerico Telegram: il bot risponde solo a te. Se manca, il bot te lo dice al primo messaggio.
TELEGRAM_USER_ID=
